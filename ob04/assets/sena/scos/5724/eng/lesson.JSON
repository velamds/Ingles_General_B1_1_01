: "feedback"}, {"type": "learning_skills", "contents": [{"content": "Listening", "type": "skill"}, {"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": " Instructions: <span class=\"bullet\">\nListen to the audio. </span> <span class=\"bullet\">\nRecord yourself saying the sentences aloud.</span>\n <span class=\"bullet\">\nCompare yourself to the audio.</span>\n", "type": "text"}]}], "type": "SR1", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn6le01ob04re2img06.jpg"}, {"text": "<span class=\"strong\">Vanessa</span>: Hey Sal, what's new with you? <br>\n<span class=\"strong\">Sally</span>: Not much.  I was just speaking to a friend who works in HR downtown.<br>\n<span class=\"strong\">Vanessa</span>: Why? Are you looking to change jobs?<br>\n<span class=\"strong\">Sally</span>: No ... remember I told you about my cousin, Nick? The one who was kicked out of the house?<br>\n<span class=\"strong\">Vanessa</span>: That's right.  What are you going to do?<br>", "id": 1, "time": "1", "image": "engenn6le01ob04re2img06.jpg"}, {"text": "<span class=\"strong\">Sally</span>: I'm going to see if I can use my connections. My uncle is too overbearing. Sometimes he is far too blunt with his comments.<br>\n<span class=\"strong\">Vanessa</span>: Did this come out of the blue or was your uncle always so difficult?<br>\n<span class=\"strong\">Sally</span>: As I told you, he's stubborn and blatantly unyielding.  <br>\n<span class=\"strong\">Vanessa</span>: Oh dear, it's better that your cousin is going to change environments.<br>", "id": 2, "time": "20000", "image": "engenn6le01ob04re2img05.jpg"}, {"text": "<span class=\"strong\">Sally</span>: I am looking forward to seeing him.  We get on like a house on fire.<br>\n<span class=\"strong\">Vanessa</span>: Are you going to be a kind of role model to him?<br>\n<span class=\"strong\">Sally</span>:  I'm not sure about that. I know that he went from a child to a teenager in a blink of an eye.<br>\n<span class=\"strong\">Vanessa</span>: I'm sure you'll have a blast together!<br>", "id": 3, "time": "43000", "image": "engenn6le01ob04re2img06.jpg"}], "audiosrc": "engenn6le01ob04re2aud01", "coverimg": "engenn6le01ob04re2img06.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}