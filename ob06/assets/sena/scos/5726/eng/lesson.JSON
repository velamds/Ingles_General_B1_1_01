{"_data": [{"contents": [{"content": "New Paths", "type": "lesson_name"}, {"content": "On the Phone", "type": "unit_name"}, {"content": 6, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 1, "type": "lesson"}, {"content": "B1.1", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Accurately use information about people's jobs and places of work in communicative situations.", "type": "primary"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_1"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_2"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_3"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_4"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_5"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_6"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_7"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_8"}], "type": "objectives"}, {"content": "engenn6le01ob06re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Talking on the Phone", "type": "heading"}, {"content": "To keep a conversation going in English, it's important to show that you are interested. You can use different types of questions. <br /><br /> For example:<br /><span class=\"italic\"> What's happening with you these days?<br />  Really?<br /> What is it?<br /> You won another million dollars?  </span><br /><br /> When you want to end a casual conversation, you can say bye, or just leave with a comment.", "type": "describer"}, {"content": "{\"rows\":4,\"columns\":1,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Ending a Conversation With Friends\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Bye. Talk to you later!</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Gotta go!</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Something is coming for you. I feel it. Bye.</span> \\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}], "type": "learning_points"}, {"contents": [{"content": "The Future", "type": "heading"}, {"content": "Comparison of future tenses: <span class=\"italic\">going to</span>, <span class=\"italic\">will</span>, and  Present Continuous", "type": "describer"}, {"content": "{\"rows\":4,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Going to</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Will</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Present Continuous</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" an intention or decision made about the future\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"a prediction for the future\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"action already arranged  or planned for the near future\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"prediction  based on knowledge or information\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"a promise \\\"}\",\"\",\"\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"a decision made spontaneously\\\"}\",\"\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "It's not going to snow. I'm certain. It's too warm. ", "type": "example"}, {"content": " In ten years, I'm going to be boss of my own successful company.", "type": "example"}, {"content": "I'll call you on Monday night.", "type": "example"}, {"content": "I'll try to be more optimistic about it. ", "type": "example"}, {"content": "I'm meeting her at 6:30. ", "type": "example"}, {"content": "They aren't arriving until Tuesday. ", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "wisecrack ", "type": "name"}, {"content": "a joke that criticizes ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Enough wisecracks out of you!", "type": "example"}, {"content": "engenn6le01ob06aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you use to talk about job hunting.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "to promote", "type": "name"}, {"content": "to advance someone to a higher position ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I got promoted last week!", "type": "example"}, {"content": "engenn6le01ob06aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "go-getter", "type": "name"}, {"content": "someone who works hard to achieve", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: She's a real go-getter and always ready to work hard.", "type": "example"}, {"content": "engenn6le01ob06aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "editor-in-chief", "type": "name"}, {"content": "the overall  editor of a publication", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The editor-in-chief always has the last word on the publication. ", "type": "example"}, {"content": "engenn6le01ob06aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "ruthless", "type": "name"}, {"content": "showing no pity or compassion ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I heard that the editor is ruthless ", "type": "example"}, {"content": "engenn6le01ob06aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "manager", "type": "name"}, {"content": "the person responsible for overseeing part of a company.", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The store manager is always fair when giving out work hours.", "type": "example"}, {"content": "engenn6le01ob06aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "fierce", "type": "name"}, {"content": "aggressive ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I heard that the new editor is fierce!", "type": "example"}, {"content": "engenn6le01ob06aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "worrywart", "type": "name"}, {"content": "someone who worries all the time, usually for no reason ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: He is such a worrywart and there is no need for it.", "type": "example"}, {"content": "engenn6le01ob06aud08", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "optimistic", "type": "name"}, {"content": "hopeful and confident ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: They are optimistic about the future of the company. ", "type": "example"}, {"content": "engenn6le01ob06aud09", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to have your fingers crossed", "type": "name"}, {"content": "to wish for luck; to wish for a positive outcome", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I'll keep my fingers crossed when you go to your interview! ", "type": "example"}, {"content": "engenn6le01ob06aud10", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "Cut up index cards into 4 equal parts.", "type": "text"}, {"content": "On 8 cards, write adjectives for personal qualities.", "type": "text"}, {"content": "On 8 cards write job names. ", "type": "text"}, {"content": "Bring your cards to class and mix them with your partner's.  ", "type": "text"}, {"content": "Turn up 1 card from each set.", "type": "text"}, {"content": "Explain why  a person in that job does or does not need to have that personal quality.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I write adjectives for personality and behavior on cards.", "type": "text"}, {"content": "I write write job names on cards.", "type": "text"}, {"content": "I talk about jobs and personal qualities.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"contents": [{}], "template_override": 1, "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn6le01ob06re2img01.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn6le01ob06re2img01.jpg", "time": "1", "id": 1, "text": "<span class=\"strong\">Peter</span>: So, enough about me. What's happening with you these days? <br>\n<span class=\"strong\">Sally</span>: Actually, I have some good news at work. <br>\n<span class=\"strong\">Peter</span>: Really? What is it? You won another million dollars? <br>\n<span class=\"strong\">Sally</span>: Hey - enough wisecracks out of you!  Well, it kind of feels like that. I got promoted!<br>\n<span class=\"strong\">Peter</span>: Wow! Congratulations. You are a real go-getter, Sal. I'm not surprised, really.<br>"}, {"image": "engenn6le01ob06re2img02.jpg", "time": "28000", "id": 2, "text": "<span class=\"strong\">Sally</span>: Thanks. So, I'm having a meeting with the editor-in-chief next week. I'm nervous about that \u2026<br>\n<span class=\"strong\">Peter</span>: You? Nervous? You're always so gregarious. <br>\n<span class=\"strong\">Sally</span>: The editor is a little ruthless. I mean, she's brilliant and obviously an excellent manager, but people say she is hard to please. She always looks fierce - ready to take on anything.<br>\n<span class=\"strong\">Peter</span>: Kind of like you! I'll bet the meeting is going to go just fine. Don't be such a worrywart. <br>"}, {"image": "engenn6le01ob06re2img05.jpg", "time": "60000", "id": 3, "text": "<span class=\"strong\">Sally</span>: You're right. I'll try to be more optimistic about it.<br>\n<span class=\"strong\">Peter</span>: Are you going to call me next week and tell me how it went?<br>\n<span class=\"strong\">Sally</span>: Sure. I'll call you Monday night. Wish me luck!<br>\n<span class=\"strong\">Peter</span>: Fingers crossed for you, Sal. <br>"}], "audiosrc": "engenn6le01ob06re2aud01", "coverimg": "engenn6le01ob06re2img01.jpg"}, "type": "slideshow"}], "id": 1}], "exercises": [{"template_override": 1, "_data": [{"contents": [{"content": " I can talk about jobs and work.", "type": "Learning Outcomes"}, {"content": " I can talk about b